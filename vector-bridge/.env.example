# Copy this file to vector-bridge/.env on the computer that can reach WirePod.
# It is intentionally ignored by Git. Do NOT use a Supabase service-role key.

# Existing SWISH backend (for example, https://your-project.backend.onspace.ai)
SWISH_BACKEND_URL=

# Public/anon key for the same backend. This is not a secret, but keep it
# separate from the browser app so the bridge can use standard REST headers.
SWISH_ANON_KEY=

# Leave these two values blank for first-time setup. Start the bridge, then
# choose "Pair this PC" in SWISH > Settings > Vector on this same computer.
# The local loopback service stores the ordinary signed-in user token and
# exact workspace scope without showing either value in the browser. Never
# use a service-role key.
SWISH_ACCESS_TOKEN=
SWISH_TENANT_ID=

# The WirePod server and Vector serial on the local network.
WIREPOD_URL=http://escapepod.local:8080
VECTOR_SERIAL=

# Polling is deliberately modest: at least 30 seconds. The first run records
# a cursor and does not announce historical orders or inventory.
POLL_INTERVAL_SECONDS=60
ANNOUNCE_NEW_ORDERS=true
ANNOUNCE_NEW_ITEMS=false

# The optional local command endpoint only binds to loopback by default.
# If exposing it to your LAN, set BRIDGE_BIND_HOST=0.0.0.0 and a long random
# BRIDGE_SHARED_SECRET. Do not expose the bridge directly to the internet.
BRIDGE_BIND_HOST=127.0.0.1
BRIDGE_PORT=8788
BRIDGE_SHARED_SECRET=

# Only this HTTPS website may make the deliberate browser-pairing request to
# the loopback bridge. Do not set this to a wildcard or another website.
SWISH_WEB_ORIGIN=https://swishflip.co.uk

